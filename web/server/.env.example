# Copy to .env and edit if your layout differs from the default.

# Port the API listens on. The Vite dev server proxies /api to it.
PORT=4000

# Root of the C project: the directory holding the Makefile, bin/ and tests/.
# Leave unset when this app lives at <project>/web, which is the default.
# IITPSX_ROOT=/home/you/iitpsx

# Optional. Leave unset to run without MongoDB; Save is then disabled and
# everything else works normally.
# MONGODB_URI=mongodb://127.0.0.1:27017/iitpsx
